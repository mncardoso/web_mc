# Shared presence on Netlify/Vercel only (ignored by local `pnpm dev`)
# Create a free DB at https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: force Redis while developing (uses Upstash quota)
# PRESENCE_REDIS=1

# Umami analytics (omit WEBSITE_ID to disable)
# Cloud: create site at https://cloud.umami.is → copy Website ID
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional self-host script URL (default: Umami Cloud)
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js

# Optional: POST target for anonymous client errors (omit to disable)
# NEXT_PUBLIC_ERROR_WEBHOOK=https://example.com/hooks/errors
